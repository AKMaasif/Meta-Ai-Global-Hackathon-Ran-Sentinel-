# copy to .env

# meta
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
PRIMARY_MODEL=muse-spark-1.3
FALLBACK_MODEL=muse-spark-1.2
REVIEWER_MODEL=muse-spark-1.2
LAST_RESORT_MODEL=muse-spark-1.1
WONDER_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1
VISION_MODEL=muse-spark-1.3
VOICE_MODEL=muse-voice-transcribe-1.0
# not -contributor, customers type personal info
ASSISTANT_MODEL=muse-spark-1.3
MODEL_MAX_TOKENS=4000
MODEL_TIMEOUT_SECONDS=60

# Spoken replies use an installed local browser/OS voice; no TTS key.

# empty = fallback twin, see docs/MAVERIC_TWIN.md
MAVERIC_URL=
MAVERIC_MODEL=ran-sentinel-seattle
MAVERIC_TIMEOUT_SECONDS=90

FCC_USERS_PER_SITE=1500
SIM_TICK_SECONDS=3

# Open demo buttons need no credentials. Optional private login settings:
OPS_EMAIL=
OPS_PASSWORD=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# minimal|low|medium|high|max, e.g. AGENT_EFFORT=investigator=low,analyst=medium
REASONING_EFFORT=
AGENT_EFFORT=

# optional, paid
FIREWORKS_API_KEY=
